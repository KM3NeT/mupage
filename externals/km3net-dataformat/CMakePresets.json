{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 0,
        "minor": 22,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "configure",
            "hidden": true,
            "cacheVariables": {
                "BUILD_SHARED_LIBS": {
                    "type": "BOOL",
                    "value": "ON"
                },
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "type": "BOOL",
                    "value": "ON"
                }
            }
        },
        {
            "name": "release",
            "inherits": "configure",
            "displayName": "Release Config",
            "description": "Release build",
            "binaryDir": "build-release",
            "installDir": "install-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "type": "string",
                    "value": "Release"
                },
                "KM3NET_DATAFORMAT_ENABLE_DOCUMENTATION": {
                    "type": "BOOL",
                    "value": "ON"
                }
            }
        },
        {
            "name": "dev",
            "inherits": "configure",
            "displayName": "Development Config",
            "description": "Development build",
            "binaryDir": "build-dev",
            "installDir": "install-dev",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "type": "string",
                    "value": "RelWithDebInfo"
                },
                "KM3NET_DATAFORMAT_ENABLE_DOCUMENTATION": {
                    "type": "BOOL",
                    "value": "OFF"
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "jobs": 4
        },
        {
            "name": "install-dev",
            "configurePreset": "dev",
            "jobs": 4,
            "targets": [
                "install"
            ]
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "install-release",
            "configurePreset": "release",
            "targets": [
                "install"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "environment": {
                "TMPDIR": "$penv{CI_PROJECT_DIR}.tmp"
            },
            "output": {
                "outputOnFailure": true,
                "outputJUnitFile": "ctest.xml"
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true,
                "jobs": 1,
                "scheduleRandom": true
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "dev",
            "steps": [
                {
                    "type": "configure",
                    "name": "dev"
                },
                {
                    "type": "build",
                    "name": "dev"
                },
                {
                    "type": "test",
                    "name": "dev"
                },
                {
                    "type": "build",
                    "name": "install-dev"
                }
            ]
        },
        {
            "name": "release",
            "steps": [
                {
                    "type": "configure",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "release"
                },
                {
                    "type": "test",
                    "name": "release"
                },
                {
                    "type": "build",
                    "name": "install-release"
                }
            ]
        }
    ]
}
