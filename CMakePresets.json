{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 0,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "configure-ninja",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "release",
      "inherits": "configure-ninja",
      "displayName": "Release Config",
      "description": "Release build using Ninja generator",
      "generator": "Ninja",
      "binaryDir": "build-release",
      "installDir": "install-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "string",
          "value": "Release"
        }
      }
    },
    {
      "name": "dev",
      "inherits": "configure-ninja",
      "displayName": "Development Config",
      "description": "Development build using Ninja generator",
      "binaryDir": "build-dev",
      "installDir": "install-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": {
          "type": "string",
          "value": "RelWithDebInfo"
        }
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 4
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [
        "install"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "environment": {
        "TMPDIR": "$penv{CI_PROJECT_DIR}.tmp"
      },
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "ctest.xml"
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true,
        "jobs": 1,
        "scheduleRandom": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    }
  ]
}
